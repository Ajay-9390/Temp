# =====================================================================================
# NBA Evidence Management — environment template. Copy to .env and adjust.
# NEVER commit real credentials or service keys.
# =====================================================================================

# ---- PostgreSQL (shared project database) ----
POSTGRES_DB=accreditation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Redis (optional statistics cache) ----
REDIS_PORT=6379
# backend cache type: none | redis
CACHE_TYPE=redis

# ---- Ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- File storage: local | supabase ----
STORAGE_PROVIDER=local
# Only used when STORAGE_PROVIDER=supabase:
SUPABASE_URL=
SUPABASE_BUCKET=nba-evidence
SUPABASE_SERVICE_KEY=

# ---- OCR (Tesseract). Requires tesseract installed in the backend image. ----
OCR_ENABLED=false

# ---- Hibernate Envers field-level history (advanced; see docs/INTEGRATION.md) ----
ENVERS_ENABLED=false

# ---- pgAdmin (web DB admin at http://localhost:5050) ----
PGADMIN_EMAIL=admin@evidence.com
PGADMIN_PASSWORD=pgadmin
PGADMIN_PORT=5050
