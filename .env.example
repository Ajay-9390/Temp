# =====================================================================
# NBA Program Management — environment variables (copy to .env)
# Never commit real secrets. These defaults are for LOCAL DEV ONLY.
# =====================================================================

# ---- Database (PostgreSQL) ----
DB_NAME=nba_program
DB_USERNAME=nba
DB_PASSWORD=change-me-in-prod
DB_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
# Toggle Keycloak JWT enforcement. false = standalone dev (no Keycloak needed).
APP_SECURITY_ENABLED=false
# Load fictional seed data on startup.
SEED_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Accreditation tiers are configurable (comma separated) — no code change needed.
ACCREDITATION_TIERS=TIER_I,TIER_II
ALLOW_MULTIPLE_ACTIVE_CYCLES=false

# ---- Keycloak (central Auth/RBAC module owns the realm) ----
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-prod
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/nba
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/nba/protocol/openid-connect/certs

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# Browser-reachable backend base URL (baked into the frontend build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ---- Reverse proxy / Monitoring ----
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-prod
