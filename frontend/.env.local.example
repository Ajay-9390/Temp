# Frontend environment (copy to .env.local). Never commit real secrets.

# Base URL of the Evidence Management backend. The Next.js server proxies /api/* to it
# (see next.config.mjs rewrites), so the browser can use relative URLs.
BACKEND_INTERNAL_URL=http://localhost:8080

# Playwright e2e base URL (optional)
E2E_BASE_URL=http://localhost:3000
